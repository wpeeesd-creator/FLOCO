{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ANTHROPIC_API_KEY": "***REMOVED***",
        "EXPO_PUBLIC_NEWS_API_KEY": "***REMOVED***",
        "EXPO_PUBLIC_KIS_APP_KEY": "***REMOVED***",
        "EXPO_PUBLIC_KIS_APP_SECRET": "***REMOVED***",
        "EXPO_PUBLIC_KIS_ACCOUNT": "***REMOVED***"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {},
      "env": {
        "EXPO_PUBLIC_ANTHROPIC_API_KEY": "***REMOVED***",
        "EXPO_PUBLIC_NEWS_API_KEY": "***REMOVED***",
        "EXPO_PUBLIC_KIS_APP_KEY": "***REMOVED***",
        "EXPO_PUBLIC_KIS_APP_SECRET": "***REMOVED***",
        "EXPO_PUBLIC_KIS_ACCOUNT": "***REMOVED***"
      },
      "autoIncrement": true
    }
  }
}